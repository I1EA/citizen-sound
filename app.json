{
  "expo": {
    "name": "Citizen Sound",
    "slug": "citizen-sound",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citizensound.app",
      "config": {
        "googleMapsApiKey": "$GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "com.citizensound.app",
      "config": {
        "googleMaps": {
          "apiKey": "$GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "f23b6d52-2bdc-4a39-ad73-5fd60b132510"
      }
    }
  }
}
